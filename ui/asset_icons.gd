static func get_icon(key: String) -> Texture2D:
 return TEXTURES.get(key)
static func item(entry: Dictionary) -> Texture2D:
 var key=entry.get("kind","")
 if key=="ammo": key=entry.get("ammo_type","arrows")
 if key=="javelins": key="javelin"
 if key=="stone": key="rock"
 return get_icon(key)
